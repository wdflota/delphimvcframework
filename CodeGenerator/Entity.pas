unit CodeGenerator.Entity;

interface

uses
  System.SysUtils, Model.Schema.Interfaces;

type
  TEntityCodeGenerator = class
  private
    class function GetDelphiType(const AColumn: TColumnInfo): string;
  public
    class function Generate(const ATableInfo: TTableInfo; const AUnitPrefix: string): string;
  end;

implementation

uses
  System.Classes, System.StrUtils, System.StringBuilder;

{ TEntityCodeGenerator }

class function TEntityCodeGenerator.GetDelphiType(const AColumn: TColumnInfo): string;
var
  LTypeName: string;
begin
  // For ActiveRecord, the PK should preferably be a NullableInt64 to allow the Store method to work.
  if AColumn.IsPrimaryKey then
  begin
    Result := 'NullableInt64';
    Exit;
  end;

  case AColumn.DataType of
    dtString: LTypeName := 'string';
    dtInteger: LTypeName := 'Integer';
    dtInt64: LTypeName := 'Int64';
    dtBoolean: LTypeName := 'Boolean';
    dtDateTime: LTypeName := 'TDateTime';
    dtFloat, dtDouble: LTypeName := 'Double';
    dtBlob: LTypeName := 'TStream'; // ActiveRecord often uses TStream for BLOBs
  else
    LTypeName := 'string'; // Default
  end;

  if AColumn.IsNullable then
    Result := 'Nullable<' + LTypeName + '>'
  else
    Result := LTypeName;
end;

class function TEntityCodeGenerator.Generate(const ATableInfo: TTableInfo; const AUnitPrefix: string): string;
var
  SB: TStringBuilder;
  LColumn: TColumnInfo;
  LAttributes: TStringList;
  LTableName: string;
  LClassName: string;
  LFieldName: string;
  LPropertyName: string;
begin
  LTableName := ATableInfo.TableName;
  // Simple pluralization to singular for class name, e.g. CUSTOMERS -> TCustomer
  if LTableName.EndsWith('S') then
    LClassName := 'T' + LTableName.Substring(0, LTableName.Length - 1).ToPascalCase
  else
    LClassName := 'T' + LTableName.ToPascalCase;

  SB := TStringBuilder.Create;
  try
    // Unit header
    SB.AppendLine('unit ' + AUnitPrefix + '.' + LClassName.Substring(1) + ';'); // Unit name without 'T'
    SB.AppendLine('');
    SB.AppendLine('interface');
    SB.AppendLine('');
    SB.AppendLine('uses');
    SB.AppendLine('  System.SysUtils, System.Classes,');
    SB.AppendLine('  MVCFramework.Serializer.Commons, MVCFramework.Nullables,');
    SB.AppendLine('  MVCFramework.ActiveRecord;');
    SB.AppendLine('');
    SB.AppendLine('type');
    SB.AppendLine('');

    // Class Attributes
    SB.AppendLine('  [MVCNameCase(ncCamelCase)]');
    SB.AppendLine('  [MVCTable(''' + ATableInfo.TableName + ''')]');
    SB.AppendLine('  ' + LClassName + ' = class(TMVCActiveRecord)');
    SB.AppendLine('  private');

    // Private Fields
    for LColumn in ATableInfo.Columns do
    begin
      LFieldName := 'f' + LColumn.ColumnName.ToPascalCase;
      SB.AppendLine('    ' + LFieldName + ': ' + GetDelphiType(LColumn) + ';');
    end;
    SB.AppendLine('  protected');
    SB.AppendLine('    // protected members');
    SB.AppendLine('  public');
    SB.AppendLine('    constructor Create; override;');
    SB.AppendLine('    destructor Destroy; override;');
    SB.AppendLine('');
    SB.AppendLine('  published');

    // Published Properties
    for LColumn in ATableInfo.Columns do
    begin
      LAttributes := TStringList.Create;
      try
        LFieldName := 'f' + LColumn.ColumnName.ToPascalCase;
        LPropertyName := LColumn.ColumnName.ToPascalCase;

        SB.Append('    [MVCTableField(''' + LColumn.ColumnName + '''');
        if LColumn.IsPrimaryKey or LColumn.IsAutoIncrement then
        begin
          SB.Append(', [');
          if LColumn.IsPrimaryKey then
            SB.Append('foPrimaryKey');
          if LColumn.IsAutoIncrement then
          begin
            if LColumn.IsPrimaryKey then SB.Append(', ');
            SB.Append('foAutoGenerated');
          end;
          SB.Append(']');
        end;
        SB.AppendLine(')]');
        SB.AppendLine('    property ' + LPropertyName + ': ' + GetDelphiType(LColumn) + ' read ' + LFieldName + ' write ' + LFieldName + ';');
        SB.AppendLine('');
      finally
        LAttributes.Free;
      end;
    end;
    SB.AppendLine('  end;');
    SB.AppendLine('');
    SB.AppendLine('implementation');
    SB.AppendLine('');
    SB.AppendLine('{ ' + LClassName + ' }');
    SB.AppendLine('');
    SB.AppendLine('constructor ' + LClassName + '.Create;');
    SB.AppendLine('begin');
    SB.AppendLine('  inherited;');
    SB.AppendLine('  // Initialization for fields, e.g., creating stream instances for BLOBs');
    SB.AppendLine('end;');
    SB.AppendLine('');
    SB.AppendLine('destructor ' + LClassName + '.Destroy;');
    SB.AppendLine('begin');
    SB.AppendLine('  // Freeing field instances');
    SB.AppendLine('  inherited;');
    SB.AppendLine('end;');
    SB.AppendLine('');
    SB.AppendLine('end.');

    Result := SB.ToString;
  finally
    SB.Free;
  end;
end;

end.
